# Copy to .env.server.local and fill in. Never commit the real file.
#
# --- AI copilot (SERVER ONLY) -------------------------------------------------
# These are read by server/env.ts inside the Node process that runs the Vite dev
# server. They are deliberately NOT prefixed VITE_, so Vite will not inline them
# into the client bundle even by accident — `import.meta.env.OPENROUTER_API_KEY`
# is undefined in the browser by construction.
#
# The browser only ever talks to our own POST /api/ai/chat endpoint. It never
# holds a provider credential and never contacts OpenRouter directly.
#
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# One place to change the model. Must support tool calling.
OPENROUTER_MODEL=anthropic/claude-sonnet-5

# Sent as HTTP-Referer / X-Title so usage is attributable in the OpenRouter
# dashboard. Neither is a secret.
OPENROUTER_APP_URL=http://localhost:5173
OPENROUTER_APP_TITLE="Formulation Explorer"
